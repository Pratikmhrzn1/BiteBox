# ==============================================================================
# BiteBox Frontend Environment Variables
# ==============================================================================
#
# By default, NO .env variables are required!
#
# 1. In Local Development:
#    Vite's built-in dev proxy (frontend/vite.config.ts) automatically routes
#    all `/api/*` requests to `http://localhost:3000`.
#
# 2. In Production (Vercel):
#    Vercel rewrites (frontend/vercel.json) automatically proxy all `/api/*`
#    requests to your Render backend (https://<your-service>.onrender.com).
#    This eliminates CORS issues and keeps uploaded images working cleanly.
#
# ------------------------------------------------------------------------------
# OPTIONAL: Direct API URL (only needed if NOT using vercel.json rewrites)
# ------------------------------------------------------------------------------
# VITE_API_URL=https://bitebox-backend.onrender.com
