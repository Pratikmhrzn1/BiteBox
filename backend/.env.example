# Database connection URLs (Neon PostgreSQL)
# DATABASE_URL: Pooled connection string (with -pooler) for Prisma Client runtime queries
DATABASE_URL="postgresql://neondb_owner:<password>@ep-delicate-cake-b338ycga-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# DATABASE_URL_UNPOOLED: Direct unpooled connection string for Prisma migrations
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:<password>@ep-delicate-cake-b338ycga.c-4.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Server configuration
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET="bitebox-dev-secret"

# Initial Admin Credentials (used during db:seed)
